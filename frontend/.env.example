# Copy to .env.local

# Base URL of the Flask API.
# Leave blank in development -- vite.config.ts proxies /api to localhost:5000.
# In production set it to your deployed backend, e.g. https://tuneup-api.onrender.com
VITE_API_BASE_URL=

# Where the dev proxy forwards /api requests (only if Flask is not on :5000)
VITE_PROXY_TARGET=http://127.0.0.1:5000
