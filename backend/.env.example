# ---------------------------------------------------------------------------
# Copy to .env  --  every value below is optional; the app boots without any.
# ---------------------------------------------------------------------------

# Flask
FLASK_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32
FLASK_DEBUG=1
PORT=5000

# Comma-separated list of allowed frontend origins.
# In production set this to your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB. Omit entirely to run with an in-memory store (no database needed).
# Local:  mongodb://localhost:27017/
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=tuneup

# ---------------------------------------------------------------------------
# YouTube Music authentication -- OPTIONAL, and best left blank in production.
#
# The only thing it unlocks is the personalised home feed. Search, song lookup
# and the random queue all work anonymously. The credential is a live Google
# session cookie for your personal account, so putting it on a public server
# means anyone who compromises that server gets your YouTube Music session.
#
# To generate one locally:  python -c "import ytmusicapi; ytmusicapi.setup()"
# ---------------------------------------------------------------------------
YTMUSIC_AUTH_FILE=
YTMUSIC_HEADERS_JSON=
YTMUSIC_LOCATION=US

# Cache lifetimes in seconds
HOME_CACHE_TTL=900
SEARCH_CACHE_TTL=600
SONG_CACHE_TTL=3600
